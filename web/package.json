{
    "name": "@malang/web",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 5173",
        "kill": "bun ../scripts/kill-port.js 5173",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "preview": "vite preview",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "fmt": "bun run format",
        "fmt:check": "bun run format:check",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "tsc --noEmit",
        "check": "bun run --parallel --no-exit-on-error format:check lint typecheck",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "dependencies": {
        "@adobe/css-tools": "4.4.4",
        "@base-ui/react": "^1.7.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@malang/shared": "workspace:*",
        "@phosphor-icons/react": "^2.1.10",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-router": "latest",
        "@tanstack/react-virtual": "^3.14.11",
        "@xyflow/react": "^12.11.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.14",
        "jotai": "^2.16.0",
        "markdown-it": "^14.1.0",
        "postcss-selector-parser": "^7.1.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "shadcn": "^4.18.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tanstack/router-cli": "^1.132.0",
        "@tanstack/router-plugin": "latest",
        "@types/node": "^22.10.2",
        "@types/markdown-it": "^14.1.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "happy-dom": "^20.0.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    }
