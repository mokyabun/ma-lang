{
    "name": "@malang/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "module": "src/index.js",
    "types": "src/index.ts",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "bun run --hot src/index.ts",
        "kill": "bun ../scripts/kill-port.js 3000",
        "build": "bun build src/index.ts --outdir=dist --target=bun --sourcemap --external msgpackr --external msgpackr-extract",
        "start": "bun dist/index.js",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "fmt": "bun run format",
        "fmt:check": "bun run format:check",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "tsc --noEmit",
        "check": "bun run --parallel --no-exit-on-error format:check lint typecheck",
        "db:generate": "drizzle-kit generate",
        "test": "bun test",
        "test:watch": "bun test --watch"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock": "^3.883.0",
        "@aws-sdk/client-bedrock-runtime": "^3.883.0",
        "@hono/zod-validator": "^0.7.6",
        "@malang/shared": "workspace:*",
        "@risuai/ccardlib": "^0.4.2",
        "@xenova/transformers": "^2.17.2",
        "drizzle-orm": "^0.44.7",
        "fflate": "^0.8.2",
        "google-auth-library": "^10.3.0",
        "hono": "^4.13.3",
        "msgpackr": "^1.11.5",
        "msgpackr-extract": "^3.0.4",
        "pino": "^10.3.1",
        "png-chunk-text": "^1.0.0",
        "png-chunks-encode": "^1.0.0",
        "png-chunks-extract": "^1.0.0",
        "re2js": "^1.2.0",
        "wasmoon": "^1.16.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@tsconfig/bun": "^1.0.10",
        "@types/bun": "latest",
        "@types/png-chunk-text": "^1.0.3",
        "@types/png-chunks-encode": "^1.0.2",
        "@types/png-chunks-extract": "^1.0.2",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.3",
        "typescript": "^5.9.3"
    }
}
