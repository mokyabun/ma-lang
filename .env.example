ADMIN_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
HOST=0.0.0.0

# Automatic DB snapshots (default: true). false overrides the in-app backup setting.
AUTO_BACKUP_ENABLED=true

# Logging defaults to pretty/colorized output in development and JSON in production.
# LOG_PRETTY=true
# LOG_COLORIZE=true
LOG_LEVEL=info

# Optional limits (bytes/count). MAX_ASSET_BYTES defaults to MAX_IMPORT_BYTES when omitted.
MAX_IMPORT_BYTES=1073741824
MAX_CARD_JSON_BYTES=8388608
MAX_ASSET_BYTES=1073741824
MAX_ARCHIVE_ENTRIES=65536
# Imports upload in chunks of this size; keep it below any reverse-proxy body limit
# (nginx client_max_body_size defaults to 1 MiB).
UPLOAD_CHUNK_BYTES=524288
