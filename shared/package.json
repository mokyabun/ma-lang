{
    "name": "@malang/shared",
    "private": true,
    "license": "GPL-3.0-only",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "fmt": "bun run format",
        "fmt:check": "bun run format:check",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "typecheck": "tsc --noEmit",
        "check": "bun run --parallel --no-exit-on-error format:check lint typecheck",
